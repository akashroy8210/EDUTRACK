# Backend Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mydashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mydashboard

# JWT Configuration (Required: provide a strong random secret in production)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=7d

# Frontend Application Origin (without trailing slash)
FRONTEND_URL=http://localhost:5173

# Environment: 'development' or 'production'
NODE_ENV=development
